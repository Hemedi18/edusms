# ==============================================================================
# EduSMS — Environment Configuration Template
# Copy to `.env` for local development. NEVER commit production secrets to Git.
# In production (`DJANGO_ENV=production`), EduSMS refuses to start if required
# cryptographic secrets are missing or left as placeholders.
# ==============================================================================

# --- Environment & Core Django ---
DJANGO_ENV=development
DJANGO_DEBUG=True
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_50_CHAR_SECRET_KEY
# 32-byte URL-safe base64 key or high-entropy passphrase derived via HKDF for Fernet encryption at rest
# Used to encrypt AI provider API keys, TOTP secrets, and webhook signing secrets
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_STRONG_32_BYTE_ENCRYPTION_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- PostgreSQL Database ---
POSTGRES_DB=edusms
POSTGRES_USER=edusms
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full URL override (supports TCP or UNIX socket `?host=/tmp/edusms-pg`)
# DATABASE_URL=postgresql://edusms:CHANGE_ME_DB_PASSWORD@localhost:5432/edusms

# --- Redis (Cache, Celery Broker, Django Channels PubSub) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- JWT & Security Policies ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
PAIRING_CODE_TTL_MINUTES=10
DEFAULT_MESSAGE_RETENTION_DAYS=90
WEBHOOK_REQUIRE_HTTPS=True
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
MAX_CAMPAIGN_RECIPIENTS_PER_RUN=5000

# --- Email (Verification & Password Reset) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@edusms.local
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# --- Default Phone Normalization ---
# Default ISO-3166 alpha-2 region when parsing national numbers (e.g., TZ -> +255)
DEFAULT_PHONE_REGION=TZ

# --- Web Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
